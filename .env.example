# HomeOps-AI Environment Configuration
# Copy this file to .env and fill in appropriate values.
# Never commit .env to version control.

# Application environment: development | staging | production
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Incident engine settings
INCIDENT_CORRELATION_WINDOW_SECONDS=300
INCIDENT_MIN_CONFIDENCE_THRESHOLD=0.3

# Safety policy settings
SAFETY_ALLOW_INFORMATIONAL_ACTIONS=true

# Future: MCP integration (NOT implemented in MVP)
# MCP_ENDPOINT=
# MCP_API_KEY=

# Future: Amazon Bedrock (NOT implemented in MVP)
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=

# Future: Alexa+ integration (NOT implemented in MVP)
# ALEXA_SKILL_ID=
# ALEXA_CLIENT_ID=
# ALEXA_CLIENT_SECRET=
