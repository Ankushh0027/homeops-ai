# HomeOps-AI Environment Configuration
# Copy this file to .env and fill in appropriate values.
# Never commit .env to version control.

# Application environment: development | staging | production
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Network & Deployment settings (auto-detected on Render)
# HOST=0.0.0.0
# PORT=8000
# PUBLIC_BASE_URL=https://homeops-ai.onrender.com
# ALLOWED_ORIGINS=*

# SQLite database path (defaults to homeops.db in repository root)
# Note: On Render Free Tier, filesystem persistence is ephemeral across restarts.
# HOMEOPS_DB_PATH=homeops.db

# Incident engine settings
INCIDENT_CORRELATION_WINDOW_SECONDS=300
INCIDENT_MIN_CONFIDENCE_THRESHOLD=0.3

# Safety policy settings
SAFETY_ALLOW_INFORMATIONAL_ACTIONS=true

# ------------------------------------------------------------------ #
# Home Assistant Integration (Leave empty when no physical HA hub)   #
# ------------------------------------------------------------------ #
# For local development with a local Home Assistant:
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=your_long_lived_access_token_here
#
# When HomeOps-AI is deployed on Render and Home Assistant is local:
# Secure options:
# 1. Cloudflare Tunnel (recommended, no open inbound ports on home router)
#    e.g. HOME_ASSISTANT_URL=https://ha.yourdomain.com
# 2. Nabu Casa Remote Access URL
#    e.g. HOME_ASSISTANT_URL=https://<unique-id>.ui.nabu.casa
# 3. WireGuard / Tailscale VPN Mesh
# HOME_ASSISTANT_URL=
# HOME_ASSISTANT_TOKEN=
# HOME_ASSISTANT_TIMEOUT_SECONDS=5.0

# ------------------------------------------------------------------ #
# Simulator Controls                                                 #
# ------------------------------------------------------------------ #
# In production, simulator is disabled by default for strict isolation.
# In development, set to true to test simulated devices and scenarios.
SIMULATOR_ENABLED=true
SIMULATOR_ALLOW_SCENARIOS=true

# Future: MCP integration (NOT implemented in MVP)
# MCP_ENDPOINT=
# MCP_API_KEY=

# Future: Amazon Bedrock (NOT implemented in MVP)
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=

# Future: Alexa+ integration (NOT implemented in MVP)
# ALEXA_SKILL_ID=
# ALEXA_CLIENT_ID=
# ALEXA_CLIENT_SECRET=
